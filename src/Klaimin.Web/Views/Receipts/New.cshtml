@model UploadForm
@{
    ViewData["Title"] = "Add receipt";
}
<div class="narrow">
    <h1>Add receipt</h1>
    <form class="panel" asp-action="New" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post" enctype="multipart/form-data"
          data-busy-label="Reading the receipt…">
        <label asp-for="Image">Photo of the receipt</label>
        <p class="hint" id="image-hint">JPEG, PNG, or WebP, up to 5 MB. The fields are read from the photo for you to check.</p>
        <input asp-for="Image" accept="image/jpeg,image/png,image/webp" required aria-describedby="image-hint" />
        <span asp-validation-for="Image" class="error"></span>
        <button type="submit">Upload photo</button>
    </form>
</div>
<script src="~/js/receipt.js" asp-append-version="true"></script>
