@model ReceiptForm
@{
    ViewData["Title"] = "Confirm receipt";
    var claimId = ViewContext.RouteData.Values["id"];
}
<h1>Confirm receipt</h1>
<div class="confirm">
    <img src="@Url.Action("Pending", new { id = claimId, upload = Model.Upload })" alt="The photo you uploaded" />
    <form asp-action="Confirm" asp-route-id="@claimId" method="post">
        <input type="hidden" name="Upload" value="@Model.Upload" />
        @if (ViewData["Notice"] is string notice)
        {
            <p class="notice">@notice</p>
        }
        <partial name="_Fields" />
        <button type="submit">Confirm receipt</button>
    </form>
</div>
<script src="~/js/receipt.js" asp-append-version="true"></script>
