@using System.Globalization
@model List<Claim>
@{
    ViewData["Title"] = "Approvals";
}
<h1>Approvals</h1>
@if (Model.Count == 0)
{
    <p class="empty">No claims are waiting for your decision.</p>
}
else
{
    <table class="stack">
        <thead>
            <tr>
                <th scope="col">Claim</th>
                <th scope="col">Claimant</th>
                <th scope="col">Submitted</th>
                <th scope="col">Waiting at</th>
                <th scope="col" class="amount">Claim total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var claim in Model)
            {
                <tr>
                    <td><a asp-controller="Claims" asp-action="Details" asp-route-id="@claim.Id">@claim.Title</a></td>
                    <td data-label="Claimant">@claim.Claimant.Email</td>
                    <td data-label="Submitted">@claim.SubmittedAt?.ToLocalTime().ToString("d MMM yyyy", CultureInfo.InvariantCulture)</td>
                    <td data-label="Waiting at">
                        @(claim.Status == ClaimStatus.AwaitingFinance ? "Finance step" : "Manager step")
                        @{
                            // Finance reads what the manager decided in this round before opening the claim.
                            var last = claim.Decisions.OrderBy(decision => decision.Id).LastOrDefault();
                        }
                        @if (claim.Status == ClaimStatus.AwaitingFinance && last is { Step: ApprovalStep.Manager })
                        {
                            <p class="hint">@last.KindLabel by @last.Approver.Email@(last.Comment is null ? "" : $": {last.Comment}")</p>
                        }
                    </td>
                    <td class="amount" data-label="Claim total">@Rupiah.Format(claim.Total)</td>
                </tr>
            }
        </tbody>
    </table>
}
