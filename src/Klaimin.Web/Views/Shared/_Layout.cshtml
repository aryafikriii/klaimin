<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · klaimin</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="brand" asp-controller="Claims" asp-action="Index">klaimin</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form class="session" asp-controller="Account" asp-action="Logout" method="post">
                <span>@User.Identity.Name</span>
                <button class="quiet" type="submit">Sign out</button>
            </form>
        }
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>
