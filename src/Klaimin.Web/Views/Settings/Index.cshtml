@model SettingsForm
@{
    ViewData["Title"] = "Settings";
}
<div class="narrow">
    <h1>Settings</h1>
    @if (TempData["Saved"] is string saved)
    {
        <p class="notice" role="status">@saved</p>
    }
    <form class="panel" asp-action="Index" method="post">
        <label asp-for="FinanceThreshold">Finance threshold</label>
        <p class="hint" id="threshold-hint">
            A claim whose total is above this goes to finance after the manager approves it.
            Claims already submitted keep the threshold they were submitted under.
        </p>
        <input asp-for="FinanceThreshold" inputmode="numeric" required aria-describedby="threshold-hint" />
        <span asp-validation-for="FinanceThreshold" class="error"></span>
        <button type="submit">Save threshold</button>
    </form>
</div>
